# Ravelry API credentials (basic read-only auth)
# Create an app at https://www.ravelry.com/pro/developer with
# "basic auth, read only access" and paste the username/password here.
RAVELRY_USERNAME=
RAVELRY_PASSWORD=

# Backend
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins for the API
CORS_ORIGINS=http://localhost:5173

# Redis (docker-compose overrides REDIS_URL for the backend container)
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
# Cache TTL for Ravelry search responses, in seconds (1 hour)
SEARCH_CACHE_TTL_SECONDS=3600

# PostgreSQL (unused in Week 1, provisioned for future weeks)
POSTGRES_USER=woolly
POSTGRES_PASSWORD=woolly
POSTGRES_DB=woolly
POSTGRES_PORT=5432
DATABASE_URL=postgresql://woolly:woolly@localhost:5432/woolly

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
