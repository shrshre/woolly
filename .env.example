# Ravelry API credentials (basic read-only auth)
# Create an app at https://www.ravelry.com/pro/developer with
# "basic auth, read only access" and paste the username/password here.
RAVELRY_USERNAME=
RAVELRY_PASSWORD=

# Conversational search ("Ask Woolly"). Leave OPENAI_API_KEY blank to disable
# the feature entirely — the UI hides it and everything else keeps working.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Asks per hour per account (or per browser session when signed out)
ASK_RATE_LIMIT_PER_HOUR=10

# Auth — generate a real secret with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_EXPIRES_DAYS=7

# Backend
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins for the API
CORS_ORIGINS=http://localhost:5173

# Redis (docker-compose overrides REDIS_URL for the backend container)
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
# Cache TTL for Ravelry search responses, in seconds (1 hour)
SEARCH_CACHE_TTL_SECONDS=3600

# PostgreSQL (unused in Week 1, provisioned for future weeks)
POSTGRES_USER=woolly
POSTGRES_PASSWORD=woolly
POSTGRES_DB=woolly
POSTGRES_PORT=5432
DATABASE_URL=postgresql://woolly:woolly@localhost:5432/woolly

# Frontend
FRONTEND_PORT=5173
# Local dev default. On Vercel, leave blank (or delete) so API calls use same-origin
# proxy rewrites in vercel.json — required for login cookies on mobile Safari.
# If unset on Vercel, use the Railway URL directly (login may not persist on iOS).
VITE_API_URL=http://localhost:8000

# Set on the backend host when the frontend is on a different domain (e.g. Vercel)
COOKIE_SECURE=false
